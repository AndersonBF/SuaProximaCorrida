generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RaceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  name         String?
  passwordHash String? // vazio para quem entra só com o Google
  googleId     String?              @unique
  createdAt    DateTime             @default(now())
  saved        SavedRace[]
  resetTokens  PasswordResetToken[]
}

model SavedRace {
  id        String   @id @default(cuid())
  userId    String
  raceId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  race      Race     @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@unique([userId, raceId])
  @@index([userId])
}

model Race {
  id          String  @id @default(cuid())
  // Identificação
  name        String
  slug        String  @unique
  description String?
  imageUrl    String?

  // Quando
  date    DateTime // data/largada
  endDate DateTime? // para eventos de mais de um dia

  // Onde
  state    String // UF, ex: "SP"
  city     String
  location String? // local de largada / endereço

  latitude  Float? // coordenadas da cidade (para "perto de mim")
  longitude Float?

  // Detalhes da prova
  distances String[] // ex: ["5km", "10km", "21km"]
  priceFrom Float? // valor a partir de (R$)
  priceTo   Float? // valor mais caro (R$)
  organizer String?

  // Origem e link
  registrationUrl String // link de inscrição no site original
  source          String    @default("Manual") // ex: "Ticket Sports", "Sympla", "Manual"
  sourceUrl       String? // página de origem (de onde veio o dado)
  externalId      String? // id da corrida no site de origem (para dedupe no scraping)
  resultsUrl      String? // link dos resultados oficiais (corridas já realizadas)
  photosUrl       String? // álbum de fotos da corrida (ex: Fotop)
  photosCheckedAt DateTime? // última busca automática de fotos

  // Detalhes extras da página da corrida
  surface        String? // ASFALTO | TRAIL | PISTA | MISTO
  level          String? // INICIANTE | INTERMEDIARIO | AVANCADO
  kitInfo        String? // o que vem no kit e onde/quando retirar
  routeUrl       String? // percurso: link do mapa ou do arquivo GPX
  elevationGain  Int? // altimetria: ganho de elevação total (m)
  lastVerifiedAt DateTime? // última vez que os dados foram conferidos (admin ou scraper)

  // Controle
  status   RaceStatus @default(PUBLISHED)
  featured Boolean    @default(false)

  clicks     Int @default(0) // cliques no botão de inscrição (saída para o site oficial)
  savesCount Int @default(0) // quantos usuários salvaram (denormalizado)

  savedBy SavedRace[]
  photos  RacePhoto[]
  lots    RaceLot[]
  reports RaceReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@index([state, city])
  @@index([date])
  @@index([status])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AssessoriaStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Assessoria / grupo de corrida de uma cidade (diretório próprio).
model Assessoria {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  city         String
  state        String
  description  String?
  trainingInfo String? // dias, horários e locais de treino
  instagram    String? // URL completa
  whatsapp     String? // só dígitos, com DDI
  website      String?
  logoUrl      String?
  contactEmail String? // privado: só o admin vê
  status       AssessoriaStatus @default(PENDING)
  createdAt    DateTime         @default(now())

  @@index([state, city])
  @@index([status])
}

/// Uma visualização de página (analytics próprio, só o admin vê).
/// `visitorId` é um id aleatório guardado em cookie — não identifica a pessoa.
model PageView {
  id         String   @id @default(cuid())
  visitorId  String
  path       String
  referrer   String? // domínio de origem (ex: "google.com"), null = direto
  device     String // "mobile" | "desktop" | "tablet"
  isNew      Boolean  @default(false) // primeira visita deste aparelho (sem cookie ainda)
  country    String? // vindo do edge da Vercel (só em produção)
  region     String?
  city       String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now()) // atualizado pelo heartbeat enquanto a aba está aberta

  @@index([createdAt])
  @@index([lastSeenAt])
  @@index([visitorId])
}

/// Álbum de fotos de uma corrida em uma plataforma (Fotop, Fotto, Banlek...).
/// Uma corrida pode ter vários (outros fotógrafos/plataformas).
model RacePhoto {
  id        String   @id @default(cuid())
  raceId    String
  provider  String // ex: "Fotop", "Foco Radical"
  url       String
  title     String? // título do álbum na plataforma
  createdAt DateTime @default(now())
  race      Race     @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@unique([raceId, url])
  @@index([raceId])
}

/// Lote de inscrição de uma distância (preço e data em que o lote vira).
model RaceLot {
  id       String    @id @default(cuid())
  raceId   String
  distance String? // ex: "10km"; null = vale para todas as distâncias
  name     String // ex: "1º lote"
  price    Float
  endsAt   DateTime? // último dia do lote; null = até acabar as vagas
  race     Race      @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@index([raceId])
}

/// Aviso de erro enviado por visitantes na página da corrida.
model RaceReport {
  id        String   @id @default(cuid())
  raceId    String
  message   String
  contact   String? // e-mail/WhatsApp opcional para retorno
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  race      Race     @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@index([raceId])
  @@index([resolved])
}
