DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require"
# Admin: ambos com 16+ caracteres, senão o login do admin fica bloqueado em produção.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_PASSWORD="troque-esta-senha"
ADMIN_SESSION_SECRET="troque-este-segredo"
NEXT_PUBLIC_DEFAULT_STATE="PR"
NEXT_PUBLIC_SITE_NAME="Corra Melhor"

# E-mail (SMTP) para o e-mail de boas-vindas
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Corra Melhor <seu@gmail.com>"

# IA (extração de preço com Claude)
ANTHROPIC_API_KEY=""

# Login com Google (Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth)
# URL de retorno autorizada: https://SEU-DOMINIO/api/auth/google/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
